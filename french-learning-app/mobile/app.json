{
  "expo": {
    "name": "Bonjour AI",
    "slug": "bonjour-ai-french",
    "scheme": "bonjourai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1B3B"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.moazkhan.bonjourai",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Bonjour AI uses your microphone so you can speak French with your AI conversation partner.",
        "NSSpeechRecognitionUsageDescription": "Bonjour AI transcribes your spoken French so the AI avatar can understand and correct you."
      }
    },
    "android": {
      "package": "com.moazkhan.bonjourai",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1B3B"
      },
      "permissions": ["RECORD_AUDIO"]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#0B1B3B"
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://french-app-server.onrender.com",
      "defaultAvatarUrl": "",
      "eas": {
        "projectId": "REPLACE_WITH_YOUR_EAS_PROJECT_ID"
      }
    }
  }
}
